{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/slastrina/rattleboard-plugins/main/schema/meta.schema.json",
  "title": "Rattleboard community plugin directory metadata (meta.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "summary",
    "author",
    "tags",
    "version",
    "license",
    "needsSecrets",
    "updated"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "news",
          "weather",
          "sport",
          "finance",
          "transport",
          "space",
          "calendar",
          "fun",
          "home",
          "tech",
          "other"
        ]
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "description": "Semver; bump on every change"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+\\-() ]{1,64}$",
      "description": "SPDX id, MIT by default"
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://"
    },
    "needsSecrets": {
      "type": "boolean",
      "description": "true exactly when the manifest declares secrets"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
