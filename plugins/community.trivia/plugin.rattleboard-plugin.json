{
  "format": 1,
  "id": "community.trivia",
  "name": "Trivia",
  "description": "A trivia question, then its answer on the next page, a new one every time it comes round (Open Trivia Database, no key needed)",
  "kind": "script",
  "script": "script.js",
  "hosts": ["opentdb.com"],
  "every": "1h",
  "dwell": "40s",
